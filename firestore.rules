rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Marketplace listings: any signed-in user can browse; only the farmer
    // who created a listing can change or remove it.
    function validListing(data) {
      return data.keys().hasOnly(['id', 'farmerId', 'farmerName', 'contact', 'crop', 'quantity',
                                  'unit', 'askingPrice', 'location', 'status', 'createdAt'])
        && data.farmerName is string && data.farmerName.size() <= 100
        && data.contact is string && data.contact.size() <= 30
        && data.crop is string && data.crop.size() > 0 && data.crop.size() <= 100
        && data.quantity is number && data.quantity > 0 && data.quantity <= 1000000
        && data.unit in ['kg', 'quintal', 'tonnes']
        && data.askingPrice is number && data.askingPrice > 0 && data.askingPrice <= 100000000
        && data.location is string && data.location.size() > 0 && data.location.size() <= 150
        && data.status in ['active', 'sold']
        && data.createdAt is string && data.createdAt.size() <= 40;
    }

    match /listings/{listingId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(listingId)
        && incoming().id == listingId
        && incoming().farmerId == request.auth.uid
        && validListing(incoming());
      allow update: if isSignedIn()
        && existing().farmerId == request.auth.uid
        && incoming().farmerId == existing().farmerId
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && validListing(incoming());
      allow delete: if isSignedIn() && existing().farmerId == request.auth.uid;
    }

    // Field-test feedback: signed-in users can add, nobody can read from the app.
    match /feedback/{id} {
      allow create: if isSignedIn()
        && incoming().keys().hasOnly(['uid', 'feature', 'helpful', 'locale', 'createdAt'])
        && incoming().uid == request.auth.uid
        && incoming().feature is string && incoming().feature.size() <= 40
        && incoming().helpful is bool
        && incoming().locale is string && incoming().locale.size() <= 5
        && incoming().createdAt is string && incoming().createdAt.size() <= 40;
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isValidId(userId)
        && incoming().id == userId
        && incoming().email is string && incoming().email.size() <= 150
        && incoming().role in ['farmer', 'buyer']
        && (!('displayName' in incoming()) || (incoming().displayName is string && incoming().displayName.size() <= 100))
        && (!('contact' in incoming()) || (incoming().contact is string && incoming().contact.size() <= 30))
        && (!('bio' in incoming()) || (incoming().bio is string && incoming().bio.size() <= 500));
      allow delete: if isOwner(userId);

      // Tasks subcollection
      match /tasks/{taskId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(taskId)
          && incoming().id == taskId
          && incoming().userId == userId
          && incoming().crop is string && incoming().crop.size() <= 150
          && incoming().date is string && incoming().date.size() <= 20
          && incoming().status in ['Upcoming', 'Done', 'Delayed'];
        allow update: if isOwner(userId)
          && incoming().userId == userId
          && incoming().status in ['Upcoming', 'Done', 'Delayed'];
        allow delete: if isOwner(userId);
      }

      // Harvest / Farm records subcollection
      match /records/{recordId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(recordId)
          && incoming().id == recordId
          && incoming().userId == userId
          && incoming().crop is string && incoming().crop.size() <= 100
          && incoming().yield is number;
        allow update: if isOwner(userId)
          && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      // Farm inventory subcollection (seeds, fertilizers, pesticides…)
      match /inventory/{itemId} {
        allow list, get: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(itemId)
          && incoming().id == itemId
          && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 150
          && incoming().category in ['Seeds', 'Fertilizers', 'Pesticides', 'Other']
          && incoming().unit in ['kg', 'litres', 'packets', 'tonnes']
          && incoming().quantity is number && incoming().quantity >= 0
          && incoming().lowStockThreshold is number && incoming().lowStockThreshold >= 0;
        allow delete: if isOwner(userId);
      }

      // Farm profile (location, land, soil, water, crop, Soil Health Card values)
      match /farm/{docId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && docId == 'main'
          && incoming().keys().hasOnly(['district', 'state', 'lat', 'lon', 'landArea', 'areaUnit', 'soilType',
                                        'waterSource', 'mainCrop', 'season', 'soilCard', 'updatedAt'])
          && (!('district' in incoming()) || (incoming().district is string && incoming().district.size() <= 150))
          && (!('state' in incoming()) || (incoming().state is string && incoming().state.size() <= 80))
          && (!('landArea' in incoming()) || (incoming().landArea is number && incoming().landArea >= 0 && incoming().landArea <= 100000))
          && (!('soilCard' in incoming()) || incoming().soilCard is map);
        allow delete: if isOwner(userId);
      }

      // Chat messages subcollection
      match /chat_messages/{messageId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(messageId)
          && incoming().id == messageId
          && incoming().userId == userId
          && incoming().role in ['user', 'model']
          && incoming().content is string && incoming().content.size() <= 10000;
        allow update: if isOwner(userId)
          && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      // Bioscience queries subcollection
      match /bioscience_queries/{queryId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(queryId)
          && incoming().id == queryId
          && incoming().userId == userId
          && incoming().compoundName is string && incoming().compoundName.size() <= 150;
        allow update: if isOwner(userId)
          && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
